PORT=5000
# Render/production must provide this value in the service Environment tab.
# MONGO_URI and DATABASE_URL are also accepted aliases.
MONGODB_URI=mongodb://127.0.0.1:27017/one-v-one-platform
MONGODB_DB_NAME=one-v-one-platform
JWT_SECRET=replace_this_with_a_strong_secret
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ADMIN_ACCESS_KEY=admin123
